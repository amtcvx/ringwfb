#include <net/udp.h>
#include <net/sock.h>
#include <linux/ip.h>

#define TARGET_UDP_PORT 5600

// Helper de calcul rapide du checksum IP requis pour la socket utilisateur
static __sum16 fast_ip_csum(struct iphdr *iph) {
    iph->check = 0;
    return ip_fast_csum((unsigned char *)iph, iph->ihl);
}

static rx_handler_result_t wfb_direct_sock_handler(struct sk_buff **pskb)
{
    struct sk_buff *skb = *pskb;
    u8 *ptr;
    u16 rtap_len;

    if (!skb) return RX_HANDLER_CONSUMED;

    ptr = skb->data;
    rtap_len = le16_to_cpup((__le16 *)(ptr + 2));

    if (skb->len < rtap_len + 26) return RX_HANDLER_PASS;

    // Détection de notre trame QoS Data (0x88)
    if (ptr[rtap_len] == 0x88) {
        u32 wifi_headers_size = rtap_len + 26;
        u32 video_payload_len = skb->len - wifi_headers_size;

        if (video_payload_len <= 0) return RX_HANDLER_CONSUMED;

        // 1. TROUVER LA SOCKET DE GSTREAMER AU PLUS VITE
        // On cherche la socket UDP locale qui écoute sur le port 5600
        struct sock *sk = __udp4_lib_lookup(&init_net, 
                                            htonl(INADDR_LOOPBACK), htons(TARGET_UDP_PORT),
                                            htonl(INADDR_LOOPBACK), htons(TARGET_UDP_PORT),
                                            0, 0, &udp_table, NULL);
        if (!sk) {
            // Pas de GStreamer actif, on détruit le paquet pour libérer rtw88
            return RX_HANDLER_CONSUMED; 
        }

        // 2. PSEUDO-ENCAPSULATION CHIRURGICALE (Sur l'espace existant)
        // On décale skb->data pour effacer l'en-tête Wi-Fi et laisser la place à l'IP/UDP
        u32 new_hdrs_len = sizeof(struct iphdr) + sizeof(struct udphdr);
        skb_pull(skb, wifi_headers_size - new_hdrs_len);

        struct iphdr *iph = (struct iphdr *)skb->data;
        struct udphdr *udph = (struct udphdr *)(skb->data + sizeof(struct iphdr));

        // Remplissage minimal de l'en-tête IP
        iph->version  = 4;
        iph->ihl      = 5;
        iph->tot_len  = htons(new_hdrs_len + video_payload_len);
        iph->protocol = IPPROTO_UDP;
        iph->saddr    = htonl(INADDR_LOOPBACK);
        iph->daddr    = htonl(INADDR_LOOPBACK);
        iph->ttl      = 64;
        iph->check    = fast_ip_csum(iph);

        // Remplissage de l'en-tête UDP
        udph->source  = htons(TARGET_UDP_PORT);
        udph->dest    = htons(TARGET_UDP_PORT);
        udph->len     = htons(sizeof(struct udphdr) + video_payload_len);
        udph->check   = 0; // Pas de checksum UDP local pour gratter du CPU

        // Configuration des pointeurs internes du SKB pour la socket
        skb_reset_network_header(skb);
        skb_set_transport_header(skb, sizeof(struct iphdr));
        skb->ip_summed = CHECKSUM_UNNECESSARY;

        // 3. INJECTION DIRECTE SANS CONTEXT-SWITCH NI INTERRUPTION LOGICIELLE
        // On pousse le SKB d'origine directement dans l'arborescence de la socket GStreamer
        if (sock_queue_rcv_skb(sk, skb) < 0) {
            // Si le buffer utilisateur est saturé (GStreamer trop lent), le noyau libère le SKB
            sock_put(sk);
            return RX_HANDLER_CONSUMED; 
        }

        sock_put(sk);

        // LE SAINT GRAAL DE LA PERFORMANCE : 
        // On retourne RX_HANDLER_CONSUMED car le SKB a été physiquement transféré à la socket.
        // Le sous-système mac80211 ne touchera plus jamais à ce paquet.
        return RX_HANDLER_CONSUMED;
    }

    return RX_HANDLER_PASS;
}

